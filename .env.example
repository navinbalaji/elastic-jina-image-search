# Everything except ADMIN_PASSWORD, SESSION_SECRET, the storage settings and S3 can also be set in the admin panel

# Elastic Cloud: Deployment > Manage > Cloud ID, and Kibana > Stack Management > API keys
ES_CLOUD_ID=
ES_API_KEY=
# Or set ES_URL instead of ES_CLOUD_ID (Serverless project endpoint or self-managed cluster)
# ES_URL=http://localhost:9200
ES_INDEX=photos

# Elastic Inference Service endpoint (preconfigured on Elastic Cloud, no extra key needed)
INFERENCE_ID=.jina-embeddings-v5-omni-small

# Where uploaded images are stored on disk
STORAGE_DIR=./storage

# Password for the /admin upload panel
ADMIN_PASSWORD=
# Optional: separate key for signing session cookies (defaults to ADMIN_PASSWORD)
# SESSION_SECRET=

# Where admin panel settings are saved (including the API key, if set there)
DATA_DIR=./data

# Optional: keep images and settings in S3 instead of on disk (required on serverless hosts such as Amplify)
# Credentials come from the default AWS chain: an IAM role, AWS_PROFILE or access keys
# S3_BUCKET=
# S3_REGION=ap-south-1
