{
  "name": "image-search",
  "version": "0.1.0",
  "private": true,
  "description": "Reverse image search with Jina CLIP embeddings, Elasticsearch kNN and Elastic UI",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
