    "format:check": "prettier --check .",
    "setup-index": "tsx --env-file=.env.local scripts/setup-index.ts"
  },
  "dependencies": {
    "@elastic/datemath": "^5.0.3",
    "@elastic/elasticsearch": "^9.5.1",
    "@elastic/eui": "^122.1.0",
    "@elastic/eui-theme-borealis": "^8.1.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "moment": "^2.31.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
